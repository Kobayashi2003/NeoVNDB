# Copy to .env and adjust. Real environment variables take precedence.

NEOVNDB_DB_URL=postgres://postgres:postgres@localhost:5432/neovndb

NEOVNDB_HOST=127.0.0.1
NEOVNDB_PORT=5100

NEOVNDB_DUMP_DIR=data/dumps
NEOVNDB_DUMP_URL=https://dl.vndb.org/dump/vndb-db-latest.tar.zst

NEOVNDB_DB_MAX_CONNS=16
NEOVNDB_DB_MIN_CONNS=2
NEOVNDB_DB_CONN_LIFETIME=1h
NEOVNDB_DB_CONNECT_TIMEOUT=10s

# What one request may ask for. These bound work, not correctness.
NEOVNDB_PAGE_SIZE=24
NEOVNDB_MAX_PAGE_SIZE=100
NEOVNDB_MAX_IDS=100
NEOVNDB_MAX_FIELD_DEPTH=3
# Estimated field values in a response, priced before the request runs.
NEOVNDB_MAX_COST=100000

# The VN relation graph is a walk, so it is bounded by depth and node count.
NEOVNDB_GRAPH_DEPTH=3
NEOVNDB_MAX_GRAPH_DEPTH=8
NEOVNDB_MAX_GRAPH_NODES=300

NEOVNDB_REQUEST_TIMEOUT=5s
NEOVNDB_READ_HEADER_TIMEOUT=10s
NEOVNDB_SHUTDOWN_TIMEOUT=10s
