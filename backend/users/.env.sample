# Copy to .env and fill in. Real environment variables win over this file.

# Its own database, not a schema beside the mirror: the mirror's schemas are
# dropped and rebuilt from the dump every week, and an account that lived next
# door would go with them.
NEOVNDB_USERS_DB_URL=postgres://user:password@localhost:5432/neovndb_users
NEOVNDB_USERS_DB_MAX_CONNS=8
NEOVNDB_USERS_DB_CONNECT_TIMEOUT=10s

NEOVNDB_USERS_HOST=127.0.0.1
NEOVNDB_USERS_PORT=5102

# How long a browser stays signed in without being asked again. Long, because
# this is a private mirror rather than a bank, and a session is a row that can
# be deleted the moment it needs to be.
NEOVNDB_USERS_SESSION_LIFE=720h

# Expired sessions are refused on sight whatever this does, so clearing them
# out is housekeeping rather than correctness.
NEOVNDB_USERS_SWEEP_EVERY=1h

# bcrypt's work factor. 12 is about a tenth of a second per attempt on current
# hardware -- nothing to a person signing in, a great deal to anyone working
# through a list. Lower it only for tests.
NEOVNDB_USERS_BCRYPT_COST=12

# Whether the session cookie may only travel over https, which also decides
# whether it carries the __Host- prefix. Off suits a local checkout; on is
# what anything actually served should use.
NEOVNDB_USERS_SECURE_COOKIE=false

NEOVNDB_USERS_READ_HEADER_TIMEOUT=10s
NEOVNDB_USERS_SHUTDOWN_TIMEOUT=10s
