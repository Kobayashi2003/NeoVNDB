# Copy to .env and fill in. Real environment variables win over this file.

# Its own database, not a schema beside the mirror: the mirror's schemas are
# dropped and rebuilt from the dump every week, and an account that lived next
# door would go with them.
NEOVNDB_USERS_DB_URL=postgres://user:password@localhost:5432/neovndb_users
NEOVNDB_USERS_DB_MAX_CONNS=8
NEOVNDB_USERS_DB_CONNECT_TIMEOUT=10s

NEOVNDB_USERS_HOST=127.0.0.1
NEOVNDB_USERS_PORT=17033

# How long a browser stays signed in without being asked again. Long, because
# this is a private mirror rather than a bank, and a session is a row that can
# be deleted the moment it needs to be.
NEOVNDB_USERS_SESSION_LIFE=720h

# Expired sessions are refused on sight whatever this does, so clearing them
# out is housekeeping rather than correctness. 0 turns the sweep off.
NEOVNDB_USERS_SWEEP_EVERY=1h
NEOVNDB_USERS_SWEEP_FIRST_AFTER=1h

# bcrypt's work factor. 12 is about a tenth of a second per attempt on current
# hardware -- nothing to a person signing in, a great deal to anyone working
# through a list. Lower it only for tests.
NEOVNDB_USERS_BCRYPT_COST=12

# Only for tests: a database whose name ends in _test, which every run empties.
# `go test ./...` uses it for the store and for the HTTP ceilings, and the
# frontend's end-to-end tests run a throwaway user service on it (17035).
# Unset, those tests skip. They read it from the environment, not from .env.
# NEOVNDB_USERS_TEST_DB_URL=postgres://user:password@localhost:5432/neovndb_users_test

# This database is the only one that cannot be rebuilt, so the service dumps
# it (pg_dump, custom format) whenever the newest copy is older than
# BACKUP_EVERY, checking every BACKUP_CHECK_EVERY (the first time
# BACKUP_FIRST_AFTER after start), and keeps the newest BACKUP_KEEP.
# BACKUP_EVERY=0 turns the schedule off; KEEP=0 keeps every copy. `users
# backup` makes one by hand. Restore:
#   pg_restore --clean --if-exists -d <database url> <file>
NEOVNDB_USERS_BACKUP_DIR=../../data/backups/users
NEOVNDB_USERS_BACKUP_EVERY=168h
NEOVNDB_USERS_BACKUP_CHECK_EVERY=1h
NEOVNDB_USERS_BACKUP_FIRST_AFTER=0s
NEOVNDB_USERS_BACKUP_KEEP=8
NEOVNDB_USERS_PG_DUMP=pg_dump

# Whether the session cookie may only travel over https, which also decides
# whether it carries the __Host- prefix. Off suits a local checkout; on is
# what anything actually served should use.
NEOVNDB_USERS_SECURE_COOKIE=false

# One page of marks by default, and the most one request may ask for; and how
# much of a list may be handed to the read API at once to be sorted or searched.
# Both ceilings are the read API's own id-list limit (NEOVNDB_MAX_IDS), because
# a page of marks is turned back into things by handing it those ids. 0 lifts
# a ceiling -- which only makes sense if the read API's limit is lifted too.
NEOVNDB_USERS_PAGE_SIZE=24
NEOVNDB_USERS_MAX_PAGE_SIZE=100
NEOVNDB_USERS_MAX_ITEMS=1000

# How often one address, or one username, may be tried before the answer is no.
# Ten in five minutes is more than someone who has forgotten which password
# they used, and nothing at all to anyone working through a list. Counted in
# memory, so a restart forgets; 0 turns the limit off.
NEOVNDB_USERS_SIGNIN_TRIES=10
NEOVNDB_USERS_SIGNIN_WINDOW=5m

# Accounts are cheap to make and nothing verifies an address yet, so this is
# all that stands between the sign-up form and a thousand of them.
NEOVNDB_USERS_SIGNUP_TRIES=5
NEOVNDB_USERS_SIGNUP_WINDOW=1h

NEOVNDB_USERS_READ_HEADER_TIMEOUT=10s
NEOVNDB_USERS_SHUTDOWN_TIMEOUT=10s
