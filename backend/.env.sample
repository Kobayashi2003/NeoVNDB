# Copy to .env and adjust. Real environment variables take precedence.

NEOVNDB_DB_URL=postgres://postgres:postgres@localhost:5432/neovndb

NEOVNDB_HOST=127.0.0.1
NEOVNDB_PORT=5100

NEOVNDB_DUMP_DIR=../data/dumps
NEOVNDB_DUMP_URL=https://dl.vndb.org/dump/vndb-db-latest.tar.zst

NEOVNDB_DB_MAX_CONNS=16
NEOVNDB_DB_MIN_CONNS=2
NEOVNDB_DB_CONN_LIFETIME=1h
NEOVNDB_DB_CONNECT_TIMEOUT=10s

# What one request may ask for. These bound work, not correctness.
# 0 means no ceiling.
NEOVNDB_PAGE_SIZE=24
NEOVNDB_MAX_PAGE_SIZE=100
NEOVNDB_MAX_IDS=100
NEOVNDB_MAX_FIELD_DEPTH=3
# Estimated field values in a response, priced before the request runs.
NEOVNDB_MAX_COST=100000

# The VN relation graph is a walk, so it is bounded by depth and node count.
NEOVNDB_GRAPH_DEPTH=3
NEOVNDB_MAX_GRAPH_DEPTH=8
NEOVNDB_MAX_GRAPH_NODES=300

NEOVNDB_REQUEST_TIMEOUT=5s
NEOVNDB_READ_HEADER_TIMEOUT=10s
NEOVNDB_SHUTDOWN_TIMEOUT=10s

# Response cache. The database only changes when an import is promoted, so a
# cached response stays correct until then and the TTL is a memory bound rather
# than a freshness one. The live generation's code is part of every key, so a
# promote makes the previous generation's entries unreachable at once.
NEOVNDB_CACHE=memory              # memory | redis | off
NEOVNDB_CACHE_TTL=1h
NEOVNDB_CACHE_ENTRIES=10000       # memory backend only
NEOVNDB_CACHE_MAX_ENTRY=1048576   # skip caching responses bigger than this
#NEOVNDB_REDIS_URL=redis://localhost:6379/0

# How much of a table may disappear between generations before promoting is
# refused. vndb only grows -- entries are hidden rather than deleted, and
# hidden ones never reach the dump -- so any real shrink means a truncated
# archive or an import that stopped partway. 0 turns the check off.
NEOVNDB_GUARD_MAX_LOSS=0.02
