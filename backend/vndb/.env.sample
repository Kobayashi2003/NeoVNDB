# Copy to .env and adjust. Real environment variables take precedence.

NEOVNDB_DB_URL=postgres://postgres:postgres@localhost:5432/neovndb

NEOVNDB_HOST=127.0.0.1
NEOVNDB_PORT=5100

NEOVNDB_DUMP_DIR=../../data/dumps
NEOVNDB_DUMP_URL=https://dl.vndb.org/dump/vndb-db-latest.tar.zst

NEOVNDB_DB_MAX_CONNS=16
NEOVNDB_DB_MIN_CONNS=2
NEOVNDB_DB_CONN_LIFETIME=1h
NEOVNDB_DB_CONNECT_TIMEOUT=10s

# What one request may ask for. These bound work, not correctness.
# 0 means no ceiling.
NEOVNDB_PAGE_SIZE=24
NEOVNDB_MAX_PAGE_SIZE=100
# A collection page hands its whole list over here when the reader asks for it
# sorted or searched, so this is also what decides how large a list that works
# for. 1000 ids is about 5KB of address and 22ms of query; past it a list can
# still be read in the order it was made, which needs no id list at all.
# The language the trans schema holds translations into. vndb writes tag and
# trait text in English only, so this is what the reader's original-text
# toggle can offer there. Changing it points the lookups at a corpus that is
# probably not seeded; see `neovndb trans status`.
NEOVNDB_TRANS_LANG=ja

# The most words one search may be made of; each costs its own index
# lookup. 0 for as many as are sent.
# Conditions in one filter expression (the `f=` parameter). Each is a clause
# and several are a subquery apiece. 0 lifts the cap.
NEOVNDB_MAX_FILTER_NODES=64
NEOVNDB_MAX_SEARCH_TERMS=8
NEOVNDB_MAX_IDS=1000
NEOVNDB_MAX_FIELD_DEPTH=3
# Estimated field values in a response, priced before the request runs.
NEOVNDB_MAX_COST=100000

# The VN relation graph is a walk, so it is bounded by depth and node count.
NEOVNDB_GRAPH_DEPTH=3
NEOVNDB_MAX_GRAPH_DEPTH=8
NEOVNDB_MAX_GRAPH_NODES=300

NEOVNDB_REQUEST_TIMEOUT=5s
NEOVNDB_READ_HEADER_TIMEOUT=10s
NEOVNDB_SHUTDOWN_TIMEOUT=10s

# Response cache. The database only changes when an import is promoted, so a
# cached response stays correct until then and the TTL is a memory bound rather
# than a freshness one. The live generation's code is part of every key, so a
# promote makes the previous generation's entries unreachable at once.
NEOVNDB_CACHE=memory              # memory | redis | off
NEOVNDB_CACHE_TTL=1h
NEOVNDB_CACHE_ENTRIES=10000       # memory backend only
NEOVNDB_CACHE_MAX_ENTRY=1048576   # skip caching responses bigger than this
#NEOVNDB_REDIS_URL=redis://localhost:6379/0

# How much of a table may disappear between generations before promoting is
# refused. vndb only grows -- entries are hidden rather than deleted, and
# hidden ones never reach the dump -- so any real shrink means a truncated
# archive or an import that stopped partway. 0 turns the check off.
NEOVNDB_GUARD_MAX_LOSS=0.02

# The image mirror (`neovndb images`). The dump carries every image's metadata
# and none of the images, so this fetches them from vndb one at a time and
# keeps what it fetched.
#
# What lands in IMAGE_DIR is what vndb served, byte for byte. Resized copies go
# to IMAGE_DERIVED_DIR instead, which can be deleted at any time without losing
# anything -- the same division the database draws between the mirrored tables
# and the derived ones.
NEOVNDB_IMAGE_PORT=5101
NEOVNDB_IMAGE_DIR=../../data/images
NEOVNDB_IMAGE_DERIVED_DIR=../../data/images-derived

# The widths pages actually render at. A request for anything else is rounded
# up to one of these: an unlisted width would be one more decode and one more
# file on disk for anyone who asked for it, so a caller cycling through numbers
# could fill the disk while never hitting the cache.
NEOVNDB_IMAGE_WIDTHS=128,256,512

# A few covers are upwards of 15000 pixels square. Decoding one costs more than
# every other request in flight put together, so past this it is refused rather
# than served slowly.
NEOVNDB_IMAGE_MAX_PIXELS=40000000
NEOVNDB_IMAGE_MAX_BYTES=33554432
NEOVNDB_IMAGE_FETCH_TIMEOUT=30s

# How many images may be fetched from vndb at once. The mirror exists to take
# load off their CDN; opening a hundred connections to it while filling the
# mirror would be a poor way to start.
NEOVNDB_IMAGE_FETCH_PARALLEL=8

# The mirror also fetches ahead of readers: every image the database knows of,
# and its upstream thumbnail (cv.t, st), that is not on disk yet -- newest first,
# PER_RUN per run, DELAY apart. The crawl reads the database only while it runs;
# serving never does. EVERY=0 turns it off; `neovndb crawl` runs one pass now.
NEOVNDB_IMAGE_CRAWL_EVERY=1h
NEOVNDB_IMAGE_CRAWL_PER_RUN=200
NEOVNDB_IMAGE_CRAWL_DELAY=2s
