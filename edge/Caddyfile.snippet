# NeoVNDB's routes, imported by ./Caddyfile and by any shared edge.
#
# Upstreams come from the environment (VNDBSERVE_UPSTREAM, IMGSERVE_UPSTREAM,
# USERSERVE_UPSTREAM, NEXT_UPSTREAM). Defaults use 127.0.0.1, not localhost: on
# Windows localhost tries ::1 first and each cold connection eats a ~20s IPv6
# timeout. NEOVNDB_IMAGE_DIR / NEOVNDB_IMAGE_DERIVED_DIR are imgserve's stores;
# relative values resolve per process, so deployments set them absolute.
#
# Each backend prefix allowlists the routes the frontend uses and answers 403
# otherwise, which is why vndbserve and imgserve hold no auth code. userserve
# guards its own routes and passes through whole.
#
# To gate browsing behind sign-in, put this at the top of each gated prefix:
#
#   forward_auth {$USERSERVE_UPSTREAM:127.0.0.1:5102} {
#       uri /auth/verify
#   }
#
# Under /imgserve it must go inside a `route` (Caddy orders directives by kind,
# so file_server would answer first), Cache-Control must become private, and
# server-rendered pages would need to forward the cookie (lib/api.ts doesn't).
#
# Rules:
#   - No matcher-less top-level `handle`: it would swallow other projects'
#     routes on a shared edge. Nested inside handle_path is fine.
#   - Prefix matcher names with @neovndb_; a shared edge puts every snippet in
#     one site block, where matcher names share a scope.
#   - Backend prefixes stay top-level so pages reach them from any route.

handle_path /vndbserve/* {
	# Anything not listed stays loopback-only.
	@neovndb_read {
		method GET HEAD
		path_regexp ^/((vn|release|character|producer|staff|tag|trait)|vn/v?[0-9]+/relations|meta/(generation|fields/[a-z]+|extlinks)|health)$
	}
	handle @neovndb_read {
		reverse_proxy {$VNDBSERVE_UPSTREAM:127.0.0.1:5100}
	}
	handle {
		respond 403
	}
}

handle_path /imgserve/* {
	# /img comes off too, leaving exactly the path inside the store for the file
	# matchers; it goes back on for the miss that reaches imgserve.
	@neovndb_img {
		method GET HEAD
		path /img/*
	}
	handle @neovndb_img {
		uri strip_prefix /img

		# A hit is served straight off disk; imgserve never wakes up. The shape is
		# checked too, since a store also holds half-written temporaries.
		@neovndb_img_derived {
			path_regexp ^/\d+/(cv|cv\.t|ch|sf|st)/\d+/\d+\.jpg$
			file {
				root {$NEOVNDB_IMAGE_DERIVED_DIR:../data/images-derived}
			}
		}
		handle @neovndb_img_derived {
			root * {$NEOVNDB_IMAGE_DERIVED_DIR:../data/images-derived}
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@neovndb_img_original {
			path_regexp ^/(cv|cv\.t|ch|sf|st)/\d+/\d+\.jpg$
			file {
				root {$NEOVNDB_IMAGE_DIR:../data/images}
			}
		}
		handle @neovndb_img_original {
			root * {$NEOVNDB_IMAGE_DIR:../data/images}
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# A miss, or a width never written because the original is narrower.
		handle {
			rewrite * /img{path}
			reverse_proxy {$IMGSERVE_UPSTREAM:127.0.0.1:5101} {
				# A cold image is a round trip to t.vndb.org and can take seconds.
				transport http {
					read_timeout 30s
					write_timeout 30s
				}
			}
		}
	}

	@neovndb_img_health {
		method GET HEAD
		path /health
	}
	handle @neovndb_img_health {
		reverse_proxy {$IMGSERVE_UPSTREAM:127.0.0.1:5101}
	}

	handle {
		respond 403
	}
}

handle_path /userserve/* {
	reverse_proxy {$USERSERVE_UPSTREAM:127.0.0.1:5102}
}
