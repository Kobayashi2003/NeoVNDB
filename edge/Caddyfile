# The edge; local checkouts use it too, so the allowlist is exercised daily.
#
#   cd edge && caddy run
#
# Run from here: the snippet's default image roots are relative to it. Routes
# live in Caddyfile.snippet; this is only the site block.
{
	auto_https off

	# Unused, and it binds :2019, colliding with any other Caddy.
	admin off
}

{$NEOVNDB_BIND::5090} {
	import Caddyfile.snippet

	# The catch-all belongs to the site block, not the snippet.
	handle {
		reverse_proxy {$NEXT_UPSTREAM:127.0.0.1:3000}
	}
}
